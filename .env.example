# Vercel 프로젝트 Settings > Environment Variables 에 실제 값으로 등록할 것.
# 이 파일 자체는 커밋해도 되지만, 실제 값이 든 .env는 절대 커밋하지 말 것.

CMS_USERNAME=
CMS_PASSWORD=
CRON_SECRET=

# 웹페이지 로그인용 (index.html / api/login.py)
ADMIN_PASSWORD=
SESSION_SECRET=

# BLOB_READ_WRITE_TOKEN 은 Blob 스토어를 이 프로젝트에 연결하면 자동으로 추가된다.
# 로컬 pipeline/pull_from_blob.py 를 돌릴 때만 별도로 값을 채워 넣으면 된다.
BLOB_READ_WRITE_TOKEN=
